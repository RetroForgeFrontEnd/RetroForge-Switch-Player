<?xml version="1.0" encoding="utf-8"?>
<!-- RetroForge: what the player shows when opened with no game. RetroForge is the front end. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_player_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content_player_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="640dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_yuzu" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/TextAppearance.Material3.HeadlineSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/player_home_title"
            android:textAlignment="center" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/SynthwaveText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/player_home_description"
            android:textAlignment="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_open_retroforge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/player_open_retroforge" />

        <include
            android:id="@+id/card_keys"
            layout="@layout/card_player_option" />

        <include
            android:id="@+id/card_firmware"
            layout="@layout/card_player_option" />

        <include
            android:id="@+id/card_driver"
            layout="@layout/card_player_option" />

        <include
            android:id="@+id/card_about"
            layout="@layout/card_player_option" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
